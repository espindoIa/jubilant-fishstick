  {
   "wait": 2500
  },
  {
   "shot": "final"
  },
  {
   "eval": "JSON.stringify({flags: Object.keys(window.__game.state.flags), party: window.__game.state.party, inv: window.__game.state.inventory, lio: window.__game.state.heroes.lio.equip})"
  }
 ],
