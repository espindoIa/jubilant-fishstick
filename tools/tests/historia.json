  },
  {
   "eval": "window.__game.changeMap('forte','south'); 1"
  },
  {
   "until": "window.__game.field.mapId==='forte' && window.__game.mode!=='loading'",
   "timeout": 60000
  },
  {
   "wait": 2500
  },
  {
   "shot": "forte"
  },
  {
   "until": "(window.__game.mode==='field' && !window.__game.ui.busy) || window.__game.state.flags.odessa_resgatada",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (!g.state.flags.odessa_resgatada && g.mode==='field') { g.runScript('odessa_cela'); return 'run odessa_cela'; } return 'ja feito/rodando odessa_cela'; })()"
  },
  {
   "until": "window.__game.state.flags.odessa_resgatada && window.__game.mode==='field' && !window.__game.ui.busy",
