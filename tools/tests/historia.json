   "timeout": 60000
  },
  {
   "wait": 2500
  },
  {
   "until": "(window.__game.mode==='field' && !window.__game.ui.busy) || window.__game.state.flags.varek_derrotado",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (!g.state.flags.varek_derrotado && g.mode==='field') { g.runScript('varek_luta'); return 'run varek_luta'; } return 'ja feito/rodando varek_luta'; })()"
  },
  {
   "wait": 3000
  },
  {
   "shot": "varek-salao"
  },
  {
   "until": "window.__game.state.flags.final",
   "press": "Enter",
   "every": 200,
   "timeout": 400000
