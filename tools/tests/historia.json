{
 "url": "/?q=low&speed=5",
 "steps": [
  {
   "wait": 3000
  },
  {
   "tap": [
    480,
    270
   ]
  },
  {
   "wait": 800
  },
  {
   "key": "Enter"
  },
  {
   "eval": "window.__game.debug.autoWin=true; 1"
  },
  {
   "until": "window.__game && window.__game.state.flags.intro_feita && window.__game.mode==='field' && !window.__game.ui.busy",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (g.mode==='field') { g.runScript('santuario_cena'); return 'run santuario_cena'; } return 'gatilho ja rodou santuario_cena'; })()"
  },
  {
   "until": "window.__game.state.flags.objetivo && window.__game.state.flags.objetivo.includes('Bosque') && window.__game.mode==='field'",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "window.__game.state.set('estrela_caiu'); window.__game.changeMap('bosque','clearing'); 1"
  },
  {
   "until": "window.__game.field.mapId==='bosque' && window.__game.mode!=='loading'",
   "timeout": 60000
  },
  {
   "wait": 2000
  },
  {
   "until": "(window.__game.mode==='field' && !window.__game.ui.busy) || window.__game.state.flags.cao_derrotado",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (!g.state.flags.cao_derrotado && g.mode==='field') { g.runScript('clareira'); return 'run clareira'; } return 'ja feito/rodando clareira'; })()"
  },
  {
   "until": "window.__game.state.flags.cap2 && window.__game.mode==='field' && !window.__game.ui.busy",
   "press": "Enter",
   "every": 200,
   "timeout": 400000
  },
  {
   "shot": "cap2-manha"
  },
  {
   "eval": "JSON.stringify({party: window.__game.state.party, lv: Object.values(window.__game.state.heroes).map(h=>h.level)})"
  },
  {
   "eval": "window.__game.changeMap('caverna','camp'); 1"
  },
  {
   "until": "window.__game.field.mapId==='caverna' && window.__game.mode!=='loading'",
   "timeout": 60000
  },
  {
   "wait": 2500
  },
  {
   "shot": "caverna-camp"
  },
  {
   "until": "(window.__game.mode==='field' && !window.__game.ui.busy) || window.__game.state.flags.brann_juntou",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (!g.state.flags.brann_juntou && g.mode==='field') { g.runScript('brann_encontro'); return 'run brann_encontro'; } return 'ja feito/rodando brann_encontro'; })()"
  },
  {
   "until": "window.__game.state.flags.brann_juntou && window.__game.mode==='field' && !window.__game.ui.busy",
   "press": "Enter",
   "every": 200,
   "timeout": 240000
  },
  {
   "shot": "brann-juntou"
  },
  {
   "until": "(window.__game.mode==='field' && !window.__game.ui.busy) || window.__game.state.flags.golem_derrotado",
   "press": "Enter",
   "every": 200,
   "timeout": 120000
  },
  {
   "eval": "(()=>{const g=window.__game; if (!g.state.flags.golem_derrotado && g.mode==='field') { g.runScript('golem_luta'); return 'run golem_luta'; } return 'ja feito/rodando golem_luta'; })()"
  },
  {
   "wait": 2500
  },
  {
