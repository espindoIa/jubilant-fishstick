{
  "url": "/?q=low&fast=1&start=vila",
  "width": 844,
  "height": 390,
  "touch": true,
  "steps": [
    {
      "until": "window.__game?.mode==='title'",
      "timeout": 60000
    },
    {
      "tap": [
        422,
        195
      ]
    },
    {
      "wait": 300
    },
    {
      "tapSelector": ".title-menu .opt:first-child"
    },
    {
      "until": "__game.mode==='field'",
      "timeout": 60000
    },
    {
      "eval": "window.__stickProbe=(()=>{const z=document.querySelector('.stick-zone');const point=(x,y)=>new Touch({identifier:1,target:z,clientX:x,clientY:y});z.dispatchEvent(new TouchEvent('touchstart',{changedTouches:[point(80,190)],bubbles:true,cancelable:true}));window.dispatchEvent(new TouchEvent('touchmove',{changedTouches:[point(172,190)],cancelable:true}));const result={...__game.input.stick};window.dispatchEvent(new TouchEvent('touchend',{changedTouches:[point(172,190)]}));return result})()"
    },
    {
      "assert": "__stickProbe.x===1 && __stickProbe.run"
    }
  ]
}